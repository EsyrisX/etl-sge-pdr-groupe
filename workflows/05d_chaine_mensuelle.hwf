      <xloc>656</xloc>
      <yloc>32</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <connections>
        <connection>
          <name>sge_postgres</name>
          <waitfor>0</waitfor>
          <waittime>millisecond</waittime>
        </connection>
      </connections>
      <name>verif_base</name>
      <description/>
      <type>CHECK_DB_CONNECTIONS</type>
      <attributes/>
      <xloc>656</xloc>
      <yloc>144</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Error</loglevel>
      <logsubject>Chaîne mensuelle</logsubject>
      <logmessage>Fichier de ventes absent pour ${MOIS} dans ${INPUTS_DIR}. Le magasin est celui de l'action verif_fichier_… terminée avec result=[false], plus haut dans le journal.</logmessage>
      <name>trace_fichier_absent</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>288</xloc>
      <yloc>208</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <message>Chaîne mensuelle interrompue pour ${MOIS} : voir la trace [Error] précédente.</message>
      <loglevel>Error</loglevel>
      <name>arret_chaine</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <xloc>256</xloc>
      <yloc>352</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Error</loglevel>
      <logsubject>Chaine mensuelle</logsubject>
      <logmessage>Base sge_postgres inaccessible : aucun traitement lancé pour ${MOIS}.</logmessage>
      <name>trace_base_inaccessible</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>512</xloc>
      <yloc>144</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Error</loglevel>
      <logsubject>Chaine mensuelle</logsubject>
      <logmessage>Échec de l'extraction (02c) pour ${MOIS} : entrepôt non modifié.</logmessage>
      <name>trace_echec_extraction</name>
      <description/>
      <type>WRITE_TO_LOG</type>
      <attributes/>
      <xloc>496</xloc>
      <yloc>240</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <loglevel>Error</loglevel>
      <logsubject>Chaine mensuelle</logsubject>
      <logmessage>Échec du chargement (04a2) pour ${MOIS} : entrepôt possiblement incomplet.</logmessage>
      <name>trace_echec_chargement</name>
      <description/>
