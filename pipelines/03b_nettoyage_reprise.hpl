      <from>motif_prix_aberrant</from>
      <to>ecriture_rejets</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>filtre_prix_plausible</from>
      <to>ecriture_ventes_nettoyees</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling>
    <error>
      <source_transform>conversion_quantite_prix</source_transform>
      <target_transform>motif_identifiant_manquant </target_transform>
      <is_enabled>Y</is_enabled>
      <nr_valuename>error_row</nr_valuename>
      <descriptions_valuename>error_description</descriptions_valuename>
      <codes_valuename>error_code</codes_valuename>
      <max_errors/>
      <max_pct_errors/>
      <min_pct_rows/>
    </error>
  </transform_error_handling>
</pipeline>
