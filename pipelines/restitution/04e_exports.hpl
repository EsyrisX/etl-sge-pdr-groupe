  <transform>
    <type>TableInput</type>
    <name>lecture_ventes_janvier</name>
    <sql>SELECT code_magasin, id_ticket, code_produit,
       to_char(date_vente, 'YYYY-MM-DD') AS date_vente,
       to_char(heure_vente, 'HH24:MI:SS') AS heure_vente,
       rayon, fournisseur, quantite, prix_unitaire,
       montant_ttc, montant_ht, montant_tva, mode_paiement
FROM entrepot_vente
WHERE date_vente >= '2026-01-01' AND date_vente &lt; '2026-02-01'
ORDER BY code_magasin, date_vente, heure_vente</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
