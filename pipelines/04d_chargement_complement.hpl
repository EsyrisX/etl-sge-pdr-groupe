    <name>calcul_montants_ht_tva</name>
    <formulas>
      <formula>
        <field_name>montant_ttc</field_name>
        <formula>[prix_unitaire] * [quantite]</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>montant_ht</field_name>
        <formula>[montant_ttc] / (1 + [taux_tva] / 100)</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
      </formula>
      <formula>
        <field_name>montant_tva</field_name>
        <formula>[montant_ttc] - [montant_ht]</formula>
        <value_type>1</value_type>
        <value_length>-1</value_length>
        <value_precision>-1</value_precision>
        <replace_field/>
        <set_na>N</set_na>
