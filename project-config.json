{
  "metadataBaseFolder" : "${PROJECT_HOME}/metadata",
  "unitTestsBasePath" : "${PROJECT_HOME}",
  "dataSetsCsvFolder" : "${PROJECT_HOME}/datasets",
  "enforcingExecutionInHome" : true,
  "autoExportMetadataFilename" : "metadata.json",
  "config" : {
    "variables" : [ {
      "name" : "DATA_DIR",
      "value" : "${PROJECT_HOME}/data",
      "description" : "dossier des données"
    }, {
      "name" : "INPUTS_DIR",
      "value" : "${DATA_DIR}/landing",
      "description" : "zone landing : fichiers reçus, jamais modifiés"
    }, {
      "name" : "OUTPUTS_DIR",
      "value" : "${DATA_DIR}/entrepot",
      "description" : "zone entrepot : fichiers livrés"
    }, {
      "name" : "STAGING_DIR",
      "value" : "${DATA_DIR}/staging",
      "description" : "zone staging : fichiers intermédiaires, jetables"
    }, {
      "name" : "REJETS_DIR",
      "value" : "${DATA_DIR}/rejets",
      "description" : "zone rejets : lignes écartées, avec leur motif"
    } ]
  }
}